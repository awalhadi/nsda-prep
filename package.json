{
  "name": "webdesign-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:extract": "bash scripts/cblm/run.sh extract_raw.py && bash scripts/cblm/run.sh selftest.py",
    "content:derive": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/derive.ts",
    "content:packs": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/packs.ts",
    "content:verify": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/verify.ts",
    "content:coverage": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/coverage.ts",
    "content:build": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/build.ts",
    "content:check": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/build.ts --check --strict=all",
    "content:approve": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/approve.ts",
    "content:proof": "bash scripts/cblm/run.sh render_proof.py",
    "content:all": "npm run content:extract && npm run content:derive && npm run content:proof && npm run content:build",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run content:check && npm run build",
    "verify:full": "npm run verify && npm run e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12",
    "zod": "4.4.3"
  }
}
