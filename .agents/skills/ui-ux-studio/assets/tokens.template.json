{
  "$comment": "Starter tokens. Semantic names only. Every foreground/background combination used in the UI is declared in `pairs` and checked by scripts/contrast.mjs. Replace the brand values, keep the structure, re-run the check. Motion values follow references/10-motion-system.md.",
  "color": {
    "bg":              { "light": "#F7F6F2", "dark": "#0B0F19" },
    "surface":         { "light": "#FFFFFF", "dark": "#111827" },
    "border":          { "light": "#E2E0D8", "dark": "#253043" },
    "border-input":    { "light": "#8A8F99", "dark": "#6B7280" },
    "text":            { "light": "#0F172A", "dark": "#E5E7EB" },
    "text-muted":      { "light": "#475569", "dark": "#9CA3AF" },
    "primary":         { "light": "#4F46E5", "dark": "#A5B4FC" },
    "on-primary":      { "light": "#FFFFFF", "dark": "#0B0F19" },
    "danger":          { "light": "#B91C1C", "dark": "#F87171" },
    "warning":         { "light": "#92400E", "dark": "#FBBF24" },
    "success":         { "light": "#047857", "dark": "#34D399" },
    "signal-danger":   { "light": "#EF4444", "dark": "#EF4444" },
    "signal-warning":  { "light": "#F59E0B", "dark": "#F59E0B" },
    "signal-success":  { "light": "#10B981", "dark": "#10B981" },
    "chip-danger-bg":  { "light": "#FEE2E2", "dark": "#3F1D1D" },
    "chip-warning-bg": { "light": "#FEF3C7", "dark": "#3B2A0B" },
    "chip-success-bg": { "light": "#D1FAE5", "dark": "#0D2E25" },
    "chip-primary-bg": { "light": "#EEF2FF", "dark": "#1E1B4B" },
    "focus-ring":      { "light": "#4F46E5", "dark": "#A5B4FC" }
  },
  "pairs": [
    { "fg": "text",         "bg": ["bg", "surface"], "kind": "text" },
    { "fg": "text-muted",   "bg": ["bg", "surface"], "kind": "text" },
    { "fg": "primary",      "bg": ["bg", "surface", "chip-primary-bg"], "kind": "text" },
    { "fg": "on-primary",   "bg": ["primary"], "kind": "text" },
    { "fg": "danger",       "bg": ["bg", "surface", "chip-danger-bg"], "kind": "text" },
    { "fg": "warning",      "bg": ["bg", "surface", "chip-warning-bg"], "kind": "text" },
    { "fg": "success",      "bg": ["bg", "surface", "chip-success-bg"], "kind": "text" },
    { "fg": "border-input", "bg": ["surface"], "kind": "ui" },
    { "fg": "focus-ring",   "bg": ["bg", "surface"], "kind": "ui" },
    { "fg": "signal-danger",  "bg": ["surface"], "kind": "decorative" },
    { "fg": "signal-warning", "bg": ["surface"], "kind": "decorative" },
    { "fg": "signal-success", "bg": ["surface"], "kind": "decorative" }
  ],
  "type": {
    "display": { "mobile": 28, "web": 32, "weight": 700, "lineHeight": 1.3 },
    "h1":      { "mobile": 22, "web": 26, "weight": 700, "lineHeight": 1.35 },
    "h2":      { "mobile": 18, "web": 20, "weight": 600, "lineHeight": 1.4 },
    "body-lg": { "mobile": 18, "web": 19, "weight": 400, "lineHeight": 1.6 },
    "body":    { "mobile": 16, "web": 17, "weight": 400, "lineHeight": 1.6 },
    "caption": { "mobile": 13, "web": 13, "weight": 400, "lineHeight": 1.5 }
  },
  "font": {
    "sans": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, monospace"
  },
  "space":  { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "radius": { "input": 8, "card": 12, "sheet": 16, "pill": 9999 },
  "touch":  { "android-dp": 48, "ios-pt": 44, "web-px": 44 },
  "elevation": { "1": "0 1px 2px rgba(15,23,42,.06), 0 1px 3px rgba(15,23,42,.08)" },
  "motion": {
    "duration": { "press": "100ms", "fast": "120ms", "base": "200ms", "slow": "300ms", "emphasis": "500ms", "count-up-max": "600ms" },
    "exit-ratio": 0.65,
    "ease": { "out": "cubic-bezier(0.16, 1, 0.3, 1)", "in": "cubic-bezier(0.7, 0, 0.84, 0)", "inOut": "cubic-bezier(0.65, 0, 0.35, 1)" },
    "spring": { "ui": { "duration": 0.35, "bounce": 0 }, "gentle": { "duration": 0.45, "bounce": 0.15 }, "playful": { "duration": 0.5, "bounce": 0.3 } },
    "stagger": "40ms", "stagger-max-items": 6,
    "distance": { "nudge": "6px", "reveal": "14px", "max": "24px" },
    "press-scale": 0.97,
    "reduced": "fade at duration.fast, or none"
  },
  "layout": { "sidebar": 240, "sidebar-collapsed": 64, "bp-tablet": 600, "bp-desktop": 1024 }
}
