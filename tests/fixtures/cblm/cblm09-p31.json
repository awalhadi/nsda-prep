.34,718.87,204.36,731.2,"learning",20,2,3],[207.58,718.87,255.1,731.2,"outcomes",20,2,4],[258.22,718.87,276.53,731.2,"that",20,2,5],[279.7,718.87,294.75,731.2,"will",20,2,6],[297.82,718.87,322.37,731.2,"meet",20,2,7],[325.42,718.87,340.8,731.2,"the",20,2,8],[343.9,718.87,364.61,731.2,"aim.",20,2,9]],"lines":[{"bbox":[90.1,792.93,365.75,806.21],"text":"Organise competency based trianing sessions_Jan 31_2012","size":12.0,"bold":false},{"bbox":[450.1,794.74,507.91,805.77],"text":"Page 31 of 71","size":9.96,"bold":false},{"bbox":[90.1,72.28,205.51,85.68],"text":"Planning a session","size":12.0,"bold":true},{"bbox":[90.1,107.59,235.61,119.92],"text":"What is a training session?","size":11.04,"bold":true},{"bbox":[90.1,134.71,504.89,147.04],"text":"A training course or program is the overall framework for the training. A training","size":11.04,"bold":false},{"bbox":[90.1,147.31,504.89,159.64],"text":"program is usually too big to be delivered using only one plan, so it is broken up into a","size":11.04,"bold":false},{"bbox":[90.1,160.03,504.89,172.36],"text":"series of shorter training sessions/lesson, which are then planned individually. Each","size":11.04,"bold":false},{"bbox":[90.1,172.63,504.93,184.96],"text":"training session will have one or a number of training outcomes, so that at the end of","size":11.04,"bold":false},{"bbox":[90.1,185.23,407.21,197.56],"text":"the session, the learners have achieved one portion of the training.","size":11.04,"bold":false},{"bbox":[90.1,208.63,233.21,220.96],"text":"Planning training sessions","size":11.04,"bold":true},{"bbox":[90.1,230.35,474.77,242.68],"text":"To conduct effective training sessions they have to be planned. A session plan","size":11.04,"bold":false},{"bbox":[90.1,243.07,347.21,255.4],"text":"should take into account a number of factors including:","size":11.04,"bold":false},{"bbox":[90.1,266.08,98.21,279.61],"text":"·","size":11.04,"bold":false},{"bbox":[108.1,267.19,417.29,279.52],"text":"The information that the trainer wants to present to the participants.","size":11.04,"bold":false},{"bbox":[90.1,281.08,98.21,294.61],"text":"·","size":11.04,"bold":false},{"bbox":[108.1,282.19,358.01,294.52],"text":"The learning outcomes to be achieved in the session.","size":11.04,"bold":false},{"bbox":[90.1,296.32,98.21,309.85],"text":"·","size":11.04,"bold":false},{"bbox":[108.1,297.43,473.93,309.76],"text":"The practise activities and tasks that will help trainees develop the competency.","size":11.04,"bold":false},{"bbox":[90.1,309.76,98.21,323.29],"text":"·","size":11.04,"bold":false},{"bbox":[108.1,310.87,444.53,323.2],"text":"The training environment and equipment required for skill development.","size":11.04,"bold":false},{"bbox":[90.1,324.4,98.21,337.93],"text":"·","size":11.04,"bold":false},{"bbox":[108.1,325.51,296.21,337.84],"text":"The delivery approach and techniques.","size":11.04,"bold":false},{"bbox":[90.1,341.08,98.21,354.61],"text":"·","size":11.04,"bold":false},{"bbox":[108.1,342.19,421.85,354.52],"text":"Assessment methods as prescribed in the Assessment Guideline.","size":11.04,"bold":false},{"bbox":[90.1,378.19,181.85,390.52],"text":"The Session Plan","size":11.04,"bold":true},{"bbox":[90.1,404.23,508.53,416.56],"text":"A session plan is a written guide used by the trainer to help ensure training is conducted","size":11.04,"bold":false},{"bbox":[90.1,416.95,260.81,429.28],"text":"in a logical and sequential manner.","size":11.04,"bold":false},{"bbox":[90.1,452.83,294.89,465.16],"text":"Session outcomes/Learning outcomes","size":11.04,"bold":true},{"bbox":[90.1,478.15,363.65,490.48],"text":"A session outcome should answer the following question","size":11.04,"bold":false},{"bbox":[90.1,504.55,405.77,516.88],"text":"What should the learner be able to do at the end of the session?","size":11.04,"bold":false},{"bbox":[90.1,530.71,505.86,543.04],"text":"Session outcomes are vital to the success of training. They provide the framework for","size":11.04,"bold":false},{"bbox":[90.1,543.31,353.21,555.64],"text":"a session, and establish a basis for revision and review","size":11.04,"bold":false},{"bbox":[90.1,568.63,438.65,580.96],"text":"A session outcome has a specified format made up of three components;","size":11.04,"bold":false},{"bbox":[108.1,595.24,116.21,608.77],"text":"·","size":11.04,"bold":false},{"bbox":[126.1,596.35,384.77,608.68],"text":"Performance – what the trainees must be able to do.","size":11.04,"bold":false},{"bbox":[108.1,623.08,116.21,636.61],"text":"·","size":11.04,"bold":false},{"bbox":[126.1,624.19,275.93,636.52],"text":"Standards – to what standard.","size":11.04,"bold":false},{"bbox":[108.1,650.92,116.21,664.45],"text":"·","size":11.04,"bold":false},{"bbox":[126.1,652.03,492.89,664.36],"text":"Conditions – under what condition will the trainees be expected to perform.","size":11.04,"bold":false},{"bbox":[90.1,686.35,252.65,698.68],"text":"Identify the learning outcomes","size":11.04,"bold":true},{"bbox":[108.1,705.16,116.21,718.69],"text":"·","size":11.04,"bold":false},{"bbox":[126.1,706.27,505.85,718.6],"text":"Once the overall training aim has been determined, the next step is to identify","size":11.04,"bold":false},{"bbox":[126.1,718.87,367.61,731.2],"text":"a set of learning outcomes that will meet the aim.","size":11.04,"bold":false}],"images":0,"annots":[{"xref":433,"type":"Highlight","rect":[90.08,109.8,232.21,120.81],"quads":[[90.08,109.8,232.21,120.81]],"color":[1.0,0.94,0.4],"content":""},{"xref":435,"type":"Highlight","rect":[90.08,209.85,230.2,220.85],"quads":[[90.08,209.85,230.2,220.85]],"color":[1.0,0.94,0.4],"content":""},{"xref":437,"type":"Highlight","rect":[90.08,379.93,179.16,390.93],"quads":[[90.08,379.93,179.16,390.93]],"color":[1.0,0.94,0.4],"content":""},{"xref":439,"type":"Highlight","rect":[93.08,688.07,250.22,699.07],"quads":[[93.08,688.07,250.22,699.07]],"color":[1.0,0.94,0.4],"content":""},{"xref":457,"type":"Highlight","rect":[202.18,244.86,298.26,255.87],"quads":[[202.18,24